root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,webp,avif,ico,pdf,woff,woff2,ttf,otf,eot,mp3,wav,ogg,flac,mp4,mov,zip,gz,tgz,7z,sqlite,db}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset