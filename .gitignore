###############################################################################
# Home Assistant config repo
#
# Strategy: ignore everything by default, then explicitly allow the config,
# automations, scripts, dashboards, blueprints, and locally maintained code that
# are useful to keep in Git.
###############################################################################

*
**/*
!*/

###############################################################################
# Repository metadata
###############################################################################

!.gitignore
!.gitattributes
!.editorconfig
!README.md
!LICENSE
!.HA_VERSION

###############################################################################
# Runtime, cache, add-on, and generated state
###############################################################################

.cache/
.cloud/
.storage/
.ssh/
.image/

deps/
tts/
tmp/
image/
log/
logs/
redis/
backup/
backups/

addons_config/*/data/
addons_config/*/logs/

###############################################################################
# Home Assistant configuration
###############################################################################

!*.yaml
!*.yml
!*.md
!*.txt
!*.json

!packages/
!packages/**

!blueprints/
!blueprints/**

!themes/
!themes/**

!custom_templates/
!custom_templates/**

!pyscript/
!pyscript/**

!python_scripts/
!python_scripts/**

###############################################################################
# Dashboards
###############################################################################

!.storage/
.storage/*
!.storage/lovelace_dashboards
!.storage/lovelace.dashboard_*

###############################################################################
# Local code and commands
###############################################################################

!scripts/
!scripts/**

!shell_commands/
!shell_commands/**

custom_components/

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

###############################################################################
# ESPHome
###############################################################################

!esphome/
!esphome/**

esphome/.device-builder.json
esphome/.device-builder-preferences.json
esphome/.esphome/
esphome/.pioenvs/
esphome/.piolibdeps/
esphome/build/
esphome/secrets.yaml
esphome/**/secrets.yaml
esphome/**/*.bin
esphome/**/*.elf
esphome/**/*.hex
*.bak*
*.backup*
*.orig

###############################################################################
# www
#
# Keep the custom sidebar config, but ignore other assets unless intentionally
# unignored later.
###############################################################################

!www/
www/*
!www/custom-sidebar-config.yaml

###############################################################################
# Zigbee, MQTT, and integration state
###############################################################################

zigbee.db
zigbee.db-*
zigbee_ota/

zigbee2mqtt/configuration*.yaml
zigbee2mqtt/coordinator_backup*.json
zigbee2mqtt/state.json
zigbee2mqtt/data/database.db
zigbee2mqtt/data/database.db-*
zigbee2mqtt/data/log/
zigbee2mqtt/data/state.json
zigbee2mqtt/data/backup/
zigbee2mqtt/data/coordinator_backup.json

###############################################################################
# Logs and databases
###############################################################################

*.log
*.log.*
*.fault
home-assistant.log
home-assistant.log.*
home-assistant-rollback.log

*.db
*.db-*
*.sqlite
*.sqlite-*
*.db-shm
*.db-wal

playbee/exports/tags/*.json

###############################################################################
# Secrets, credentials, certificates, and local auth material
###############################################################################

secrets.yaml
secret.yaml
**/secrets.yaml
**/secret.yaml

*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.ovpn
*.token
*.tokens
*.credentials
*.creds
*.passwd
*.password

.env
.env.*
.google.token
google_calendars.yaml

###############################################################################
# Sensitive or ephemeral Home Assistant files
###############################################################################

ip_bans.yaml
known_devices.yaml
homekit_controller-entity-map
homekit_controller-*.json
home-assistant_v2.db*
watchman_report.txt
*.pickle
*.pid
*.lock
.ha_run.lock

###############################################################################
# Editor and OS junk
###############################################################################

.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak
*~
.DS_Store
Thumbs.db
desktop.ini
